{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "buildCommand": null,
  "outputDirectory": "src",
  "routes": [
    { "src": "/", "dest": "/auth/login.html" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/user", "dest": "/user/index.html" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/user/(.*)", "dest": "/user/$1" },
    { "src": "/shared/(.*)", "dest": "/shared/$1" },
    { "src": "/auth/(.*)", "dest": "/auth/$1" }
  ]
}
